# Required for live Flipkart Affiliate API requests.
FLIPKART_AFFILIATE_ID=replace_with_affiliate_id
FLIPKART_AFFILIATE_TOKEN=replace_with_affiliate_token

# Optional configuration.
FLIPKART_TIMEOUT_SECONDS=8
FLIPKART_API_URL=https://affiliate-api.flipkart.net/affiliate/1.0/search.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Use true for local development without affiliate credentials.
# Set false in production to require live Flipkart data.
USE_MOCK_FLIPKART=true